      "path": "accounting.sql",
      "text": "CREATE OR REPLACE PACKAGE accounting AS\n  g_total NUMBER := 0;\n  FUNCTION adjusted(p_amount NUMBER) RETURN NUMBER;\n  PROCEDURE calculate(p_count NUMBER);\nEND accounting;\n/\nCREATE OR REPLACE PACKAGE BODY accounting AS\n  g_total NUMBER := 0;\n\n  FUNCTION adjusted(p_amount NUMBER) RETURN NUMBER IS\n  BEGIN\n    RETURN p_amount * 1.1;\n  END adjusted;\n\n  PROCEDURE calculate(p_count NUMBER) IS\n    v_amount NUMBER := 0;\n  BEGIN\n    g_total := 0;\n    FOR i IN 1..p_count LOOP\n      v_amount := adjusted(i);\n      IF v_amount > 10 THEN\n        g_total := g_total + v_amount;\n      ELSE\n        g_total := 0;\n      END IF;\n    END LOOP;\n    INSERT INTO totals(amount) VALUES (g_total);\n    COMMIT;\n  EXCEPTION\n    WHEN OTHERS THEN\n      ROLLBACK;\n      RAISE;\n  END calculate;\nBEGIN\n  g_total := 0;\nEND accounting;\n/\n",
      "text_sha256": "ddcb9a7939c2297593ca49a726052db0e4fbce2d994755fba7d515f12dfdd8f7"
